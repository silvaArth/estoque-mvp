# Porta em que o servidor Express irá escutar
PORT=3000

# URL de conexão com o banco de dados PostgreSQL
#
# Opção 1 — Supabase (recomendado):
#   Acesse o painel do Supabase > Project Settings > Database > Connection pooler (Transaction mode)
#   e copie a string de conexão no formato abaixo:
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Opção 2 — PostgreSQL local:
# DATABASE_URL=postgres://<usuario>:<senha>@localhost:5432/<nome-do-banco>
